// Copy this file to Secrets.xcconfig (same folder) and fill in real values.
// Secrets.xcconfig is gitignored — never commit your real Client ID/Secret.
//
// Leave a line blank/omit it to keep Shared.xcconfig's default for that key.
//
// Remember: "//" inside a URL must be written as "/$()/" in xcconfig.

VISTA_BASE_URL = https:/$()/api.vistabanana.com
CF_ACCESS_CLIENT_ID = your-client-id.access
CF_ACCESS_CLIENT_SECRET = your-client-secret
