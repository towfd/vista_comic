<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
	  Dev-only App Transport Security exception so URLSession and AsyncImage can
	  reach the local backend over cleartext http://localhost (M5 Slice 3).
	  GENERATE_INFOPLIST_FILE stays YES: Xcode merges its generated keys on top
	  of this partial plist (INFOPLIST_FILE), so only the ATS keys live here.
	-->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
		<key>NSExceptionDomains</key>
		<dict>
			<key>localhost</key>
			<dict>
				<key>NSExceptionAllowsInsecureHTTPLoads</key>
				<true/>
				<key>NSIncludesSubdomains</key>
				<true/>
			</dict>
		</dict>
	</dict>

	<!--
	  Backend connectivity, baked in at build time from Config/Shared.xcconfig
	  (+ the gitignored Config/Secrets.xcconfig override) rather than read from
	  ProcessInfo.environment, so it survives launches with no Xcode attached.
	  See Networking/ComicRepository.swift (APIConfig).
	-->
	<key>VistaBaseURL</key>
	<string>$(VISTA_BASE_URL)</string>
	<key>CFAccessClientID</key>
	<string>$(CF_ACCESS_CLIENT_ID)</string>
	<key>CFAccessClientSecret</key>
	<string>$(CF_ACCESS_CLIENT_SECRET)</string>
</dict>
</plist>
